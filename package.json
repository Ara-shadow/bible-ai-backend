{
    "name":  "bible-ai-backend",
    "version":  "1.0.0",
    "description":  "Bible AI Backend API",
    "main":  "dist/server.js",
    "scripts":  {
                    "build":  "tsc",
                    "prestart":  "npm run build",
                    "postinstall":  "npm run build",
                    "setup-admin":  "tsx src/scripts/setupAdmin.ts",
                    "start":  "node dist/server.js",
                    "dev":  "tsx watch src/server.ts"
                },
    "dependencies":  {
                         "axios":  "^1.20.0",
                         "bcryptjs":  "^2.4.3",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.3.1",
                         "express":  "^4.18.2",
                         "express-session":  "^1.17.3",
                         "helmet":  "^7.0.0",
                         "morgan":  "^1.10.0",
                         "openai":  "^7.9.0"
                     },
    "devDependencies":  {
                            "typescript":  "^5.2.2",
                            "tsx":  "^3.13.0",
                            "@types/node":  "^20.8.0"
                        }
}
